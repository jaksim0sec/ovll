{
  "description": "Schema form validation only. Domain/authorization checks must be implemented separately.",
  "cases": [
    {
      "name": "plain conversation",
      "target": "ModelTurn",
      "valid": true,
      "data": {
        "message": "현재 작업은 설명으로 충분합니다."
      }
    },
    {
      "name": "canvas read from communication",
      "target": "ModelTurn",
      "valid": true,
      "data": {
        "needs": [
          {
            "kind": "graph",
            "selector": {
              "scope": "current",
              "depth": "semantic"
            },
            "purpose": "Explain node connections"
          }
        ]
      }
    },
    {
      "name": "IR Patch then run multiple actions",
      "target": "ModelTurn",
      "valid": true,
      "data": {
        "actions": [
          {
            "localKey": "p1",
            "kind": "ir.applyPatch",
            "args": {
              "patch": {
                "expectedGraphRevision": 7,
                "definitions": [
                  {
                    "localKey": "def_compare",
                    "purpose": "Compare conflicting evidence",
                    "executorKind": "model_task",
                    "inputs": [
                      {
                        "name": "evidence",
                        "role": "source evidence",
                        "representation": "evidence_bundle"
                      }
                    ],
                    "outputs": [
                      {
                        "name": "comparison",
                        "role": "comparison",
                        "representation": "structured_text"
                      }
                    ],
                    "instruction": "Compare evidence while preserving source references."
                  }
                ],
                "operations": [
                  {
                    "op": "node.add",
                    "localNodeKey": "tmp_compare",
                    "definitionRef": {
                      "localDefinitionKey": "def_compare"
                    }
                  },
                  {
                    "op": "link.add",
                    "localLinkKey": "tmp_link",
                    "kind": "data",
                    "from": {
                      "node": {
                        "nodeId": "source1"
                      },
                      "port": "result"
                    },
                    "to": {
                      "node": {
                        "localNodeKey": "tmp_compare"
                      },
                      "port": "evidence"
                    }
                  }
                ],
                "adoption": "workspace_only",
                "graphId": "g_current"
              }
            }
          },
          {
            "localKey": "e1",
            "kind": "run.start",
            "dependsOn": [
              "p1"
            ],
            "args": {
              "targets": [
                {
                  "fromAction": "p1",
                  "localNodeKey": "tmp_compare"
                }
              ],
              "damMode": "closed"
            }
          }
        ]
      }
    },
    {
      "name": "node result output",
      "target": "ModelTurn",
      "valid": true,
      "data": {
        "outputs": {
          "status": "produced",
          "values": {
            "comparison": {
              "inline": "Comparison with source references"
            }
          }
        }
      }
    },
