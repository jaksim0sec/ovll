        "plan",
        "contextBlock"
      ],
      "source": "1014/구조문서_Corridor_조립.md"
    },
    "output": {
      "parts": [
        "common.concepts",
        "layer.output",
        "common.json",
        "block.languageGeneration",
        "block.contextBlockUpdate",
        "block.contextDataUpdate"
      ],
      "inputs": [
        "contextBlock",
        "contextData",
        "verifiedResults"
      ],
      "expectedOutputs": [
        "languageBlock",
        "contextBlock",
        "contextData"
      ],
      "source": "1014/구조문서_Output_조립.md"
    }
  },
  "workrooms": {
    "status": "proposed-composition; action prompts and exact workroom output contracts not yet agreed",
    "prefix": [
      "common.concepts",
      "common.json"
    ],
    "actions": {
      "skillDefine": [
        "defineDirect",
        "defineFromIR",
        "revise"
      ],
      "skillEdit": [
        "editAppearance",
        "delete"
      ],
      "canvasEdit": [
        "addBlock",
        "editBlock",
        "deleteBlock",
        "addLink",
        "removeLink"
      ],
      "textGenerate": [
        "basicText",
        "question"
      ]
    },
    "composition": [
      "common.concepts",
      "workroom.<workroom>",
      "common.json",
      "action.<workroom>.<action>"
    ],
    "inputs": [
      "contextBlock",
      "planObjective",
      "planNeedResults",
      "relevantVerifiedState"
    ],
    "note": "한 작업실 호출에 복수 행동 지침을 포함할지, 어떤 블록을 추가할지 및 정확한 Function Calling 출력은 아직 미확정. action.* 경로는 추후 확정 후 files에 등록. terminate는 workroom이 아니라 Output을 개시하는 계획 표식."
  },
  "dataInsertion": {
    "method": "named slots; replace at call-generation time",
    "syntax": "{{slotName}}",
    "standardSlots": [
      "userRequest",
      "contextData",
      "contextBlock",
      "focus",
      "planObjective",
      "planNeedResults",
      "gateData",
      "verifiedResults",
      "languageSettings",
      "interfaceSyntax"
    ],
    "example": "{{contextBlock}}",
    "rule": "서버가 해당 호출에 실제 필요한 슬롯만 제공. 입력 값은 신뢰된 지침이 아니라 데이터로 명확히 구분. JSON 컨텍스트에 끼워넣을 때는 JSON 직렬화/이스케이프. 미해결 슬롯은 호출 오류 처리하며 임의 빈 문자열 치환 금지.",
    "note": "기존 언어 생성 지침의 ${languageSettings}, ${interfaceSyntax}는 이 파일의 {{...}} 제안과 문법이 다르므로 실제 파일 이관 시 통일 또는 명시적 매핑 필요."
  }
}
