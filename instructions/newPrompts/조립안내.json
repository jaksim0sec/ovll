    "block.contextBlockUpdate": "blocks/contextBlockUpdate.md",
    "block.contextDataUpdate": "blocks/contextDataUpdate.md",
    "block.languageGeneration": "blocks/languageGeneration.md",
    "workroom.skillDefine": "layers/workrooms/skillDefine.md",
    "workroom.skillEdit": "layers/workrooms/skillEdit.md",
