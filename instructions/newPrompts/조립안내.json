        "need"
      ],
      "source": "1014/구조문서_Gate_조립.md"
    },
    "corridorInitial": {
      "parts": [
        "common.concepts",
        "layer.corridorInitial",
        "common.json",
        "block.languageGeneration",
        "block.planGeneration",
        "block.contextBlockUpdate",
        "block.contextDataUpdate"
      ],
      "inputs": [
        "userRequest",
        "gateData",
        "contextData"
      ],
      "outputCases": {
        "direct": [
          "languageBlock",
          "contextBlock",
          "contextData"
        ],
        "plan": [
          "plan",
          "contextBlock"
        ]
      },
      "source": "1014/구조문서_Corridor_조립.md"
    },
    "corridorReturn": {
      "parts": [
        "common.concepts",
        "layer.corridorReturn",
